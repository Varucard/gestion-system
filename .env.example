# Copiar a .env y completar. El archivo .env NO se versiona.

TZ=America/Argentina/Buenos_Aires
APP_DEBUG=false
# Dirección pública del sistema (se usa en los links de los emails)
APP_URL=http://localhost:8060

# Conexión de la aplicación
DB_HOST=database
DB_PORT=3306
DB_DATABASE=servicio_tecnico
DB_USERNAME=gestion
DB_PASSWORD=cambiar_esta_clave

# Solo para el contenedor de MySQL
MYSQL_ROOT_PASSWORD=cambiar_esta_clave_root

# Envío de emails (recordatorios de turnos). Vacío = deshabilitado.
# Ej. Gmail: smtp://usuario%40gmail.com:CLAVE_DE_APLICACION@smtp.gmail.com:587
MAIL_DSN=
MAIL_FROM=

# Puertos publicados en el host. phpMyAdmin y MySQL solo escuchan en el propio
# servidor (127.0.0.1); para abrirlos a la red local, poner 0.0.0.0 (no recomendado).
APP_PORT=8060
PMA_PORT=8061
DB_HOST_PORT=8817
APP_BIND=127.0.0.1
PMA_BIND=127.0.0.1
DB_BIND=127.0.0.1

# Si el sistema queda detrás de un proxy (nginx, Cloudflare, etc.): sus IPs o rangos
# separados por coma, para tomar la IP real del cliente y detectar HTTPS.
# Ej.: TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1
TRUSTED_PROXIES=

# Copia adicional de cada backup en otra carpeta (disco externo o carpeta sincronizada
# con la nube) montada en el contenedor. Vacío = solo storage/backups.
BACKUP_COPIA_DIR=

# Registro del sistema: debug | info | warning | error (por defecto info) y días a conservar
LOG_LEVEL=info
LOG_DIAS=30

# produccion (por defecto) | desarrollo (instala Xdebug y usa el php.ini de desarrollo).
# Al cambiarlo hay que reconstruir: docker compose up -d --build
ENTORNO=produccion

# Solo con ENTORNO=desarrollo: off | debug | develop,debug
XDEBUG_MODE=off
